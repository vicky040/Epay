# Postgres connection string (provisioned by the Neon integration on Vercel)
DATABASE_URL=
# Signing key for the mobile app's bearer tokens
JWT_SECRET=
# Signing key for the admin console session cookie
ADMIN_JWT_SECRET=
# Public origin, used to build invite links
APP_PUBLIC_URL=
# Set automatically when a Vercel Blob store is linked
BLOB_READ_WRITE_TOKEN=
